# 需求：pip install openai gTTS playsound==1.2.2

import os
import tempfile
from openai import OpenAI
from gtts import gTTS
from playsound import playsound

# === LM Studio 本機 API 設定 ===
client = OpenAI(
    base_url="http://127.0.0.1:1234/v1",  # LM Studio 本機伺服器 /v1
    api_key="lm-studio"                   # 多數情況任意字串即可，視 LM Studio 設定
)

MODEL = "openai/gpt-oss-20b"

# === 對話初始系統指令（預設繁體中文） ===
history = [
    {
        "role": "system",
        "content": (
            "你是專業的中文助理。請全程使用 繁體中文（台灣）回覆，"
            "用詞與標點採台灣慣用法，除非使用者明確要求其他語言或格式。"
        ),
    },
]

def speak_zh_tw(text: str) -> None:
    """
    使用 gTTS 將文字轉為語音（繁體中文）並「同步」播放。
    主播放器為 playsound；若失敗，改用 os.startfile 作為後備（非阻塞）。
    """
    if not text or not text.strip():
        return

    # 產生臨時 MP3 檔
    tts = gTTS(text=text, lang="zh-TW", slow=False)

    fd, path = tempfile.mkstemp(suffix=".mp3")
    os.close(fd)  # 關閉檔案描述符，讓 gTTS 正常寫入

    try:
        tts.save(path)
        try:
            # 同步播放（阻塞）
            playsound(path)
        except Exception as e:
            print(f"[TTS 播放警告] playsound 失敗：{e}，改用系統預設播放器。")
            try:
                # 後備方案（非阻塞）：交給系統預設播放器
                os.startfile(path)  # Windows 專用；若是 macOS/Linux 需改為 'open' / 'xdg-open'
            except Exception as e2:
                print(f"[TTS 播放失敗] 系統預設播放器也無法啟動：{e2}")
    finally:
        # 清理：若用 os.startfile 非阻塞，這裡不能立刻刪檔；簡化處理：只在 playsound 成功時刪檔
        # 你若想更嚴謹，可改成延遲刪除或下次啟動時清理 temp。
        try:
            os.remove(path)
        except Exception:
            pass

def chat_once(user_text: str) -> str:
    """呼叫 LM Studio（OpenAI 相容 chat/completions）取得助理回覆。"""
    resp = client.chat.completions.create(
        model=MODEL,
        messages=history + [{"role": "user", "content": user_text}],
        temperature=0.7,
    )
    return resp.choices[0].message.content

def main() -> None:
    try:
        while True:
            user = input("你：").strip()
            if not user or user.lower() in {"exit", "quit"} or user in {"離開", "結束", "退出"}:
                break

            # 呼叫模型取得回覆
            try:
                answer = chat_once(user)
            except Exception as e:
                print(f"[聊天錯誤] {e}")
                continue

            # 顯示與語音
            print("助理：", answer)
            try:
                speak_zh_tw(answer)
            except Exception as e:
                print(f"[TTS 錯誤] {e}（將略過語音播放）")

            # 累積對話歷史
            history.append({"role": "user", "content": user})
            history.append({"role": "assistant", "content": answer})

    except (KeyboardInterrupt, EOFError):
        print("\n已結束。")

if __name__ == "__main__":
    main()
